# ============================================================
# શ્રદ્ધાંજલિ (Shradhanjali) - Environment Variables
# ============================================================

# Application
NODE_ENV=production
PORT=3000
NEXT_PUBLIC_SITE_URL=https://shradhanjali.in

# Authentication Secret (Change to random 32+ character string in production)
SESSION_SECRET=shradhanjali_super_secure_jwt_secret_key_2026

# Optional: PostgreSQL / Supabase Database Connection
# If left empty, the application runs automatically using the zero-config ACID file database in data/db.json
DATABASE_URL=postgresql://postgres:password@localhost:5432/shradhanjali

# Analytics & Ads (Can also be set directly from Admin Dashboard -> Settings)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_ADSENSE_PUB_ID=
